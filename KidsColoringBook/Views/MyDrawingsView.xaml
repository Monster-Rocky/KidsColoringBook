<UserControl x:Class="KidsColoringBook.Views.MyDrawingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="{StaticResource AppBackgroundBrush}">

    <Grid Margin="25,15,25,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Gallery list / empty state -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Style="{StaticResource KidRoundButtonStyle}"
                    Background="#9E9E9E" Width="140" Height="46"
                    Command="{Binding BackCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⬅" FontSize="18" Margin="0,0,8,0"/>
                    <TextBlock Text="Home" FontSize="16"/>
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="1" Text="🖼 My Drawings Gallery"
                       FontSize="28" FontWeight="Bold" Foreground="#2C3E50"
                       FontFamily="{StaticResource KidFontFamily}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- Empty State -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="20" Padding="40">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource KidCardStyle}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasDrawings}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="🎨" FontSize="72" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                <TextBlock Text="No Saved Drawings Yet!" FontSize="24" FontWeight="Bold" Foreground="#334155"
                           HorizontalAlignment="Center" Margin="0,0,0,8" FontFamily="{StaticResource KidFontFamily}"/>
                <TextBlock Text="Choose a sketch from the gallery or create your own drawing to see it here!"
                           FontSize="16" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Saved Drawings List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasDrawings}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>

            <ItemsControl ItemsSource="{Binding SavedDrawings}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="260" Height="360" Margin="14" Style="{StaticResource KidCardStyle}">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="180"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Artwork Thumbnail with Open click -->
                                <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Command="{Binding DataContext.OpenDrawingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Border Background="#F8FAFC" CornerRadius="14" ClipToBounds="True">
                                        <Image Source="{Binding ThumbnailPath}" Stretch="Uniform" Margin="6"/>
                                    </Border>
                                </Button>

                                <!-- Details -->
                                <StackPanel Grid.Row="1" Margin="0,8,0,8">
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="#1E293B"
                                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding FormattedDate}" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Action Buttons: Edit, Rename, Print, Export, Delete -->
                                <UniformGrid Grid.Row="2" Rows="2" Columns="2" VerticalAlignment="Bottom">
                                    <!-- Edit -->
                                    <Button Style="{StaticResource KidRoundButtonStyle}" Content="✏ Edit" Height="34" Margin="2"
                                            Background="#3B82F6" FontSize="12"
                                            Command="{Binding DataContext.OpenDrawingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <!-- Print -->
                                    <Button Style="{StaticResource KidRoundButtonStyle}" Content="🖨 Print" Height="34" Margin="2"
                                            Background="#10B981" FontSize="12"
                                            Command="{Binding DataContext.PrintDrawingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <!-- Rename -->
                                    <Button Style="{StaticResource KidRoundButtonStyle}" Content="🏷 Rename" Height="34" Margin="2"
                                            Background="#F59E0B" FontSize="12"
                                            Command="{Binding DataContext.RenameDrawingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <!-- Delete -->
                                    <Button Style="{StaticResource KidRoundButtonStyle}" Content="🗑 Delete" Height="34" Margin="2"
                                            Background="#EF4444" FontSize="12"
                                            Command="{Binding DataContext.DeleteDrawingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </UniformGrid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
