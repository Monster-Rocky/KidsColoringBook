<UserControl x:Class="KidsColoringBook.Views.GalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="{StaticResource AppBackgroundBrush}">

    <Grid Margin="25,15,25,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar: Back, Title, Search -->
            <RowDefinition Height="Auto"/> <!-- Difficulty Level Tabs -->
            <RowDefinition Height="Auto"/> <!-- Category Filter Pills -->
            <RowDefinition Height="*"/>    <!-- Sketches Grid -->
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Back to Dashboard Button -->
            <Button Style="{StaticResource KidRoundButtonStyle}"
                    Background="#9E9E9E" Width="140" Height="46"
                    Command="{Binding BackCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⬅" FontSize="18" Margin="0,0,8,0"/>
                    <TextBlock Text="Home" FontSize="16"/>
                </StackPanel>
            </Button>

            <!-- Title -->
            <TextBlock Grid.Column="1" Text="✨ Choose Your Sketch ✨"
                       FontSize="28" FontWeight="Bold" Foreground="#2C3E50"
                       FontFamily="{StaticResource KidFontFamily}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- Search Box -->
            <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="20" BorderBrush="#CBD5E1" BorderThickness="2"
                    Height="42" Width="220" Padding="10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0" Background="Transparent"
                             FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Difficulty Level Tabs -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="24" Padding="6" Margin="0,0,0,12" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <Button Content="⭐ Easy (100)" Width="170" Height="44" Margin="4,0"
                        Command="{Binding SelectDifficultyCommand}" CommandParameter="Easy">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource KidRoundButtonStyle}">
                            <Setter Property="Background" Value="#E2E8F0"/>
                            <Setter Property="Foreground" Value="#475569"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedDifficulty}" Value="Easy">
                                    <Setter Property="Background" Value="#4CAF50"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="⭐⭐ Medium (100)" Width="170" Height="44" Margin="4,0"
                        Command="{Binding SelectDifficultyCommand}" CommandParameter="Medium">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource KidRoundButtonStyle}">
                            <Setter Property="Background" Value="#E2E8F0"/>
                            <Setter Property="Foreground" Value="#475569"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedDifficulty}" Value="Medium">
                                    <Setter Property="Background" Value="#FF9800"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="⭐⭐⭐ Hard (100)" Width="170" Height="44" Margin="4,0"
                        Command="{Binding SelectDifficultyCommand}" CommandParameter="Hard">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource KidRoundButtonStyle}">
                            <Setter Property="Background" Value="#E2E8F0"/>
                            <Setter Property="Foreground" Value="#475569"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedDifficulty}" Value="Hard">
                                    <Setter Property="Background" Value="#E91E63"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- Category Pills Filter -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,15">
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding}" Height="36" Padding="14,0" Margin="4,0"
                                Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource KidRoundButtonStyle}">
                                    <Setter Property="Background" Value="#FFFFFF"/>
                                    <Setter Property="Foreground" Value="#334155"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Sketches Grid -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding FilteredSketches}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="200" Height="230" Margin="10" Style="{StaticResource KidCardStyle}">
                            <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Command="{Binding DataContext.SelectSketchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Grid Margin="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="160"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Thumbnail image -->
                                    <Border Background="#F8FAFC" CornerRadius="12" ClipToBounds="True">
                                        <Image Source="{Binding ThumbnailPath}" Stretch="Uniform" Margin="6"/>
                                    </Border>

                                    <!-- Title & category -->
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="#1E293B"
                                                   TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Category}" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
