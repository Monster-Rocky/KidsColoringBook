<Window x:Class="KidsColoringBook.Views.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print Preview"
        Height="800" Width="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        Background="#ECEFF1">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Controls Panel -->
        <Border Background="#FFFFFF" BorderBrush="#CFD8DC" BorderThickness="0,0,1,0" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="🖨 Print Preview" FontSize="24" FontWeight="Bold" Foreground="#1E88E5"
                               FontFamily="Comic Sans MS, Segoe UI" Margin="0,0,0,20"/>

                    <!-- Child Name -->
                    <TextBlock Text="Child's Name / Signature:" FontSize="14" FontWeight="Bold" Foreground="#37474F" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtChildName" FontSize="16" FontWeight="SemiBold" Height="40" VerticalContentAlignment="Center"
                             Padding="8,0" TextChanged="OnNameOrDateChanged" Margin="0,0,0,15" BorderBrush="#90CAF9" BorderThickness="2">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <!-- Date -->
                    <TextBlock Text="Print Date:" FontSize="14" FontWeight="Bold" Foreground="#37474F" Margin="0,0,0,6"/>
                    <DatePicker x:Name="DatePickerControl" Height="40" FontSize="15" SelectedDateChanged="OnNameOrDateChanged" Margin="0,0,0,20"/>

                    <!-- Orientation -->
                    <TextBlock Text="Page Orientation:" FontSize="14" FontWeight="Bold" Foreground="#37474F" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                        <RadioButton x:Name="RbPortrait" Content="Portrait (A4)" IsChecked="True" Checked="OnOrientationChanged" FontSize="14" Margin="0,0,15,0" FontWeight="SemiBold"/>
                        <RadioButton x:Name="RbLandscape" Content="Landscape (A4)" Checked="OnOrientationChanged" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Print Button -->
                    <Button Content="🖨 Print Now" Height="50"
                            Background="#4CAF50" Foreground="White"
                            FontSize="18" FontWeight="Bold"
                            Margin="0,0,0,12" Click="OnPrintClick">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="25"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Save as PDF Button -->
                    <Button Content="📄 Save as PDF" Height="44"
                            Background="#0288D1" Foreground="White"
                            FontSize="16" FontWeight="Bold"
                            Margin="0,0,0,12" Click="OnSavePdfClick">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="22"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Save as PNG Button -->
                    <Button Content="🖼 Save as Image (PNG)" Height="44"
                            Background="#FB8C00" Foreground="White"
                            FontSize="16" FontWeight="Bold"
                            Margin="0,0,0,20" Click="OnSavePngClick">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="22"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Close Button -->
                    <Button Content="✖ Close Preview" Height="42"
                            Background="#90A4AE" Foreground="White"
                            FontSize="15" FontWeight="Bold"
                            Click="OnCloseClick">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="21"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Right Preview Canvas -->
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#ECEFF1" Padding="30">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#66000000" Opacity="0.3"/>
                </Border.Effect>
                <ContentControl x:Name="PreviewHost"/>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
