<UserControl x:Class="KidsColoringBook.Views.ColoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100"
             Background="{StaticResource AppBackgroundBrush}">

    <Grid Margin="12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & quick info -->
            <RowDefinition Height="*"/>    <!-- Main Workspace (Left, Center, Right) -->
            <RowDefinition Height="Auto"/> <!-- Bottom Action Bar -->
        </Grid.RowDefinitions>

        <!-- Top Title Bar -->
        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="14" Padding="14,8" Margin="0,0,0,8" Style="{StaticResource KidCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎨 " FontSize="22"/>
                    <TextBlock Text="{Binding CurrentSketch.Title}" FontSize="20" FontWeight="Bold" Foreground="#1E293B"
                               FontFamily="{StaticResource KidFontFamily}"/>
                    <TextBlock Text=" • " FontSize="18" Foreground="#94A3B8"/>
                    <TextBlock Text="{Binding CurrentSketch.Difficulty}" FontSize="16" FontWeight="SemiBold" Foreground="#0284C7"/>
                </StackPanel>

                <!-- Zoom Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource KidRoundButtonStyle}" Content="🔍+" Width="46" Height="38" Margin="3,0"
                            Background="#E2E8F0" Foreground="#334155" Command="{Binding ZoomInCommand}" ToolTip="Zoom In"/>
                    <Button Style="{StaticResource KidRoundButtonStyle}" Content="🔍-" Width="46" Height="38" Margin="3,0"
                            Background="#E2E8F0" Foreground="#334155" Command="{Binding ZoomOutCommand}" ToolTip="Zoom Out"/>
                    <Button Style="{StaticResource KidRoundButtonStyle}" Content="⛶ Fit" Width="60" Height="38" Margin="3,0"
                            Background="#E2E8F0" Foreground="#334155" Command="{Binding FitToScreenCommand}" ToolTip="Fit to Screen"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Workspace (Left, Center, Right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/> <!-- Left Panel Tools -->
                <ColumnDefinition Width="*"/>   <!-- Center Canvas -->
                <ColumnDefinition Width="230"/> <!-- Right Panel Palette -->
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: Tools -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="18" Padding="10" Margin="0,0,8,0" Style="{StaticResource KidCardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel HorizontalAlignment="Center">
                        
                        <TextBlock Text="TOOLS" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                        <!-- Fill Tool -->
                        <Button Height="64" Width="100" Margin="0,0,0,10"
                                Command="{Binding SelectToolCommand}" CommandParameter="Fill">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource KidRoundButtonStyle}">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                    <Setter Property="Foreground" Value="#334155"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFillSelected}" Value="True">
                                            <Setter Property="Background" Value="#FF6B6B"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🪣" FontSize="26" HorizontalAlignment="Center"/>
                                <TextBlock Text="Fill" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Pencil Tool -->
                        <Button Height="64" Width="100" Margin="0,0,0,10"
                                Command="{Binding SelectToolCommand}" CommandParameter="Pencil">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource KidRoundButtonStyle}">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                    <Setter Property="Foreground" Value="#334155"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPencilSelected}" Value="True">
                                            <Setter Property="Background" Value="#4D96FF"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="✏" FontSize="26" HorizontalAlignment="Center"/>
                                <TextBlock Text="Pencil" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Eraser Tool -->
                        <Button Height="64" Width="100" Margin="0,0,0,14"
                                Command="{Binding SelectToolCommand}" CommandParameter="Eraser">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource KidRoundButtonStyle}">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                    <Setter Property="Foreground" Value="#334155"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEraserSelected}" Value="True">
                                            <Setter Property="Background" Value="#9D4EDD"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🧹" FontSize="26" HorizontalAlignment="Center"/>
                                <TextBlock Text="Eraser" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Separator Background="#E2E8F0" Margin="5,0,5,12"/>

                        <!-- Undo -->
                        <Button Style="{StaticResource KidRoundButtonStyle}" Height="46" Width="100" Margin="0,0,0,8"
                                Background="#E2E8F0" Foreground="#334155" Command="{Binding UndoCommand}"
                                ToolTip="Undo Last Action">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↩" FontSize="18" Margin="0,0,6,0"/>
                                <TextBlock Text="Undo" FontSize="14"/>
                            </StackPanel>
                        </Button>

                        <!-- Redo -->
                        <Button Style="{StaticResource KidRoundButtonStyle}" Height="46" Width="100" Margin="0,0,0,12"
                                Background="#E2E8F0" Foreground="#334155" Command="{Binding RedoCommand}"
                                ToolTip="Redo Action">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↪" FontSize="18" Margin="0,0,6,0"/>
                                <TextBlock Text="Redo" FontSize="14"/>
                            </StackPanel>
                        </Button>

                        <!-- Clear All -->
                        <Button Style="{StaticResource KidRoundButtonStyle}" Height="44" Width="100" Margin="0,0,0,8"
                                Background="#FEE2E2" Foreground="#DC2626" Command="{Binding ClearAllCommand}">
                            <TextBlock Text="Clear All" FontSize="13" FontWeight="Bold"/>
                        </Button>

                        <!-- Reset Original -->
                        <Button Style="{StaticResource KidRoundButtonStyle}" Height="44" Width="100"
                                Background="#FFEDD5" Foreground="#C2410C" Command="{Binding ResetOriginalCommand}">
                            <TextBlock Text="Reset Sketch" FontSize="12" FontWeight="Bold"/>
                        </Button>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- CENTER: Large Sketch Canvas -->
            <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="18" Style="{StaticResource KidCardStyle}" ClipToBounds="True">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#F1F5F9">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                        <Border BorderBrush="#CBD5E1" BorderThickness="3" CornerRadius="12" Background="#FFFFFF">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="4" Opacity="0.12" Color="#000000"/>
                            </Border.Effect>

                            <Image x:Name="SketchCanvasImage"
                                   Source="{Binding CanvasBitmap}"
                                   Width="800" Height="800"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   RenderOptions.EdgeMode="Unspecified"
                                   SnapsToDevicePixels="True"
                                   UseLayoutRounding="True"
                                   MouseDown="OnCanvasMouseDown"
                                   MouseMove="OnCanvasMouseMove"
                                   MouseUp="OnCanvasMouseUp"
                                   TouchDown="OnCanvasTouchDown"
                                   TouchMove="OnCanvasTouchMove"
                                   TouchUp="OnCanvasTouchUp"
                                   StylusDown="OnCanvasStylusDown"
                                   StylusMove="OnCanvasStylusMove"
                                   StylusUp="OnCanvasStylusUp"
                                   Cursor="Cross">
                                <Image.LayoutTransform>
                                    <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}"/>
                                </Image.LayoutTransform>
                            </Image>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- RIGHT PANEL: Colour Palette & Pencil Thickness -->
            <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="18" Padding="12" Margin="8,0,0,0" Style="{StaticResource KidCardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Selected Colour Preview -->
                        <TextBlock Text="COLOURS" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,6"/>

                        <Border Width="64" Height="64" CornerRadius="32"
                                BorderBrush="#E2E8F0" BorderThickness="4"
                                HorizontalAlignment="Center" Margin="0,0,0,8"
                                Background="{Binding SelectedColorBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="3" Opacity="0.2" Color="#000000"/>
                            </Border.Effect>
                        </Border>

                        <!-- Custom Colour Button -->
                        <Button Style="{StaticResource KidRoundButtonStyle}" Content="🎨 Custom Colour..." Height="38"
                                Background="#8B5CF6" Foreground="#FFFFFF" Margin="0,0,0,12"
                                Command="{Binding PickCustomColorCommand}"/>

                        <!-- Predefined Palette Swatches -->
                        <ItemsControl ItemsSource="{Binding PaletteColors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="36" Height="36" Margin="3" Cursor="Hand"
                                            Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding Name}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="18" Background="{Binding Brush}" BorderBrush="#CBD5E1" BorderThickness="2">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="4" Direction="270" ShadowDepth="2" Opacity="0.1" Color="#000000"/>
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Recently Used Colours -->
                        <TextBlock Text="RECENT COLOURS" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,14,0,6"/>
                        <ItemsControl ItemsSource="{Binding RecentColors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="28" Height="28" Margin="2" Cursor="Hand"
                                            Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="14" Background="{Binding Brush}" BorderBrush="#94A3B8" BorderThickness="1"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Background="#E2E8F0" Margin="5,14,5,10"/>

                        <!-- Pencil Thickness -->
                        <TextBlock Text="BRUSH THICKNESS" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        
                        <!-- 4 Brush Thickness Preset Buttons -->
                        <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,8">
                            <!-- Thin (4px) -->
                            <Button Width="50" Height="34" Margin="2" FontSize="11"
                                    Command="{Binding SelectThicknessCommand}" CommandParameter="4">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource KidRoundButtonStyle}">
                                        <Setter Property="Background" Value="#F1F5F9"/>
                                        <Setter Property="Foreground" Value="#334155"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsThinBrushSelected}" Value="True">
                                                <Setter Property="Background" Value="#3B82F6"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="Thin"/>
                            </Button>

                            <!-- Medium (8px) -->
                            <Button Width="50" Height="34" Margin="2" FontSize="11"
                                    Command="{Binding SelectThicknessCommand}" CommandParameter="8">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource KidRoundButtonStyle}">
                                        <Setter Property="Background" Value="#F1F5F9"/>
                                        <Setter Property="Foreground" Value="#334155"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMediumBrushSelected}" Value="True">
                                                <Setter Property="Background" Value="#3B82F6"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="Med"/>
                            </Button>

                            <!-- Thick (16px) -->
                            <Button Width="50" Height="34" Margin="2" FontSize="11"
                                    Command="{Binding SelectThicknessCommand}" CommandParameter="16">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource KidRoundButtonStyle}">
                                        <Setter Property="Background" Value="#F1F5F9"/>
                                        <Setter Property="Foreground" Value="#334155"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsThickBrushSelected}" Value="True">
                                                <Setter Property="Background" Value="#3B82F6"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="Thick"/>
                            </Button>

                            <!-- Jumbo (28px) -->
                            <Button Width="50" Height="34" Margin="2" FontSize="11"
                                    Command="{Binding SelectThicknessCommand}" CommandParameter="28">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource KidRoundButtonStyle}">
                                        <Setter Property="Background" Value="#F1F5F9"/>
                                        <Setter Property="Foreground" Value="#334155"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsJumboBrushSelected}" Value="True">
                                                <Setter Property="Background" Value="#3B82F6"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="Jumbo"/>
                            </Button>
                        </WrapPanel>

                        <!-- Live Interactive Brush Size Preview -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5"
                                CornerRadius="12" Padding="8,6" Margin="0,2,0,8" HorizontalAlignment="Center" Width="140">
                            <StackPanel HorizontalAlignment="Center">
                                <Grid Width="48" Height="48" HorizontalAlignment="Center">
                                    <Ellipse Stroke="#CBD5E1" StrokeThickness="1" StrokeDashArray="2 2" Width="46" Height="46"/>
                                    <Ellipse Width="{Binding BrushPreviewSize}" Height="{Binding BrushPreviewSize}"
                                             Fill="{Binding BrushPreviewColorBrush}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="{Binding BrushThicknessDescription}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Slider Minimum="2" Maximum="36" Value="{Binding BrushThickness}" Margin="8,0"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- BOTTOM ACTION BAR -->
        <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="16" Padding="14,10" Margin="0,8,0,0" Style="{StaticResource KidCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Back to Gallery -->
                <Button Style="{StaticResource KidRoundButtonStyle}"
                        Background="#64748B" Width="170" Height="46"
                        Command="{Binding BackCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⬅" FontSize="18" Margin="0,0,8,0"/>
                        <TextBlock Text="Back to Gallery" FontSize="15"/>
                    </StackPanel>
                </Button>

                <!-- Center Save & Prints -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <!-- Save -->
                    <Button Style="{StaticResource KidRoundButtonStyle}"
                            Background="#10B981" Width="160" Height="46" Margin="0,0,12,0"
                            Command="{Binding SaveArtworkCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Save Artwork" FontSize="15"/>
                        </StackPanel>
                    </Button>

                    <!-- Print Coloured -->
                    <Button Style="{StaticResource KidRoundButtonStyle}"
                            Background="#3B82F6" Width="180" Height="46" Margin="0,0,12,0"
                            Command="{Binding PrintColouredCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Print Coloured" FontSize="15"/>
                        </StackPanel>
                    </Button>

                    <!-- Print Original -->
                    <Button Style="{StaticResource KidRoundButtonStyle}"
                            Background="#F59E0B" Width="180" Height="46"
                            Command="{Binding PrintOriginalCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Print Original" FontSize="15"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
