<UserControl x:Class="KidsColoringBook.Views.DrawOwnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100"
             Background="{StaticResource AppBackgroundBrush}">

    <Grid Margin="12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar -->
            <RowDefinition Height="*"/>    <!-- Main Canvas Area -->
            <RowDefinition Height="Auto"/> <!-- Bottom Actions -->
        </Grid.RowDefinitions>

        <!-- Top Title Bar -->
        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="14" Padding="14,8" Margin="0,0,0,8" Style="{StaticResource KidCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✏ " FontSize="22"/>
                    <TextBlock Text="Draw Your Own Sketch" FontSize="20" FontWeight="Bold" Foreground="#1E293B"
                               FontFamily="{StaticResource KidFontFamily}"/>
                </StackPanel>

                <!-- Undo / Redo / Clear -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource KidRoundButtonStyle}" Content="↩ Undo" Width="90" Height="38" Margin="3,0"
                            Background="#E2E8F0" Foreground="#334155" Command="{Binding UndoCommand}"/>
                    <Button Style="{StaticResource KidRoundButtonStyle}" Content="↪ Redo" Width="90" Height="38" Margin="3,0"
                            Background="#E2E8F0" Foreground="#334155" Command="{Binding RedoCommand}"/>
                    <Button Style="{StaticResource KidRoundButtonStyle}" Content="🗑 Clear" Width="90" Height="38" Margin="3,0"
                            Background="#FEE2E2" Foreground="#DC2626" Command="{Binding ClearCanvasCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/> <!-- Left Tools -->
                <ColumnDefinition Width="*"/>   <!-- Center Canvas -->
                <ColumnDefinition Width="230"/> <!-- Right Palette -->
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: Shape & Drawing Tools -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="18" Padding="8" Margin="0,0,8,0" Style="{StaticResource KidCardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="TOOLS" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,6"/>

                        <!-- Pencil -->
                        <Button Height="54" Width="96" Margin="0,0,0,6"
                                Command="{Binding SelectToolCommand}" CommandParameter="Pencil">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource KidRoundButtonStyle}">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                    <Setter Property="Foreground" Value="#334155"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPencilSelected}" Value="True">
                                            <Setter Property="Background" Value="#3B82F6"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="✏" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="Pencil" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <!-- Eraser -->
                        <Button Height="54" Width="96" Margin="0,0,0,8"
                                Command="{Binding SelectToolCommand}" CommandParameter="Eraser">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource KidRoundButtonStyle}">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                    <Setter Property="Foreground" Value="#334155"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEraserSelected}" Value="True">
                                            <Setter Property="Background" Value="#9D4EDD"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🧹" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="Eraser" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <Separator Background="#E2E8F0" Margin="4,0,4,8"/>
                        <TextBlock Text="SHAPES" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,6"/>

                        <!-- Line -->
                        <Button Height="46" Width="96" Margin="0,0,0,6"
                                Command="{Binding SelectToolCommand}" CommandParameter="Line">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource KidRoundButtonStyle}">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                    <Setter Property="Foreground" Value="#334155"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLineSelected}" Value="True">
                                            <Setter Property="Background" Value="#10B981"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📏" FontSize="16" Margin="0,0,4,0"/>
                                <TextBlock Text="Line" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <!-- Rectangle -->
                        <Button Height="46" Width="96" Margin="0,0,0,6"
                                Command="{Binding SelectToolCommand}" CommandParameter="Rectangle">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource KidRoundButtonStyle}">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                    <Setter Property="Foreground" Value="#334155"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRectangleSelected}" Value="True">
                                            <Setter Property="Background" Value="#10B981"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⬛" FontSize="16" Margin="0,0,4,0"/>
                                <TextBlock Text="Rect" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <!-- Circle -->
                        <Button Height="46" Width="96" Margin="0,0,0,6"
                                Command="{Binding SelectToolCommand}" CommandParameter="Circle">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource KidRoundButtonStyle}">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                    <Setter Property="Foreground" Value="#334155"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCircleSelected}" Value="True">
                                            <Setter Property="Background" Value="#10B981"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚪" FontSize="16" Margin="0,0,4,0"/>
                                <TextBlock Text="Circle" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <!-- Star -->
                        <Button Height="46" Width="96" Margin="0,0,0,6"
                                Command="{Binding SelectToolCommand}" CommandParameter="Star">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource KidRoundButtonStyle}">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                    <Setter Property="Foreground" Value="#334155"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStarSelected}" Value="True">
                                            <Setter Property="Background" Value="#F59E0B"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⭐" FontSize="16" Margin="0,0,4,0"/>
                                <TextBlock Text="Star" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <!-- Heart -->
                        <Button Height="46" Width="96" Margin="0,0,0,6"
                                Command="{Binding SelectToolCommand}" CommandParameter="Heart">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource KidRoundButtonStyle}">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                    <Setter Property="Foreground" Value="#334155"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHeartSelected}" Value="True">
                                            <Setter Property="Background" Value="#EC4899"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💖" FontSize="16" Margin="0,0,4,0"/>
                                <TextBlock Text="Heart" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- CENTER: Large Blank Canvas -->
            <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="18" Style="{StaticResource KidCardStyle}" ClipToBounds="True">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#F1F5F9">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                        <Border BorderBrush="#CBD5E1" BorderThickness="3" CornerRadius="12" Background="#FFFFFF">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="4" Opacity="0.12" Color="#000000"/>
                            </Border.Effect>

                            <Image x:Name="DrawCanvasImage"
                                   Source="{Binding CanvasBitmap}"
                                   Width="800" Height="800"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   RenderOptions.EdgeMode="Unspecified"
                                   SnapsToDevicePixels="True"
                                   UseLayoutRounding="True"
                                   MouseDown="OnCanvasMouseDown"
                                   MouseMove="OnCanvasMouseMove"
                                   MouseUp="OnCanvasMouseUp"
                                   TouchDown="OnCanvasTouchDown"
                                   TouchMove="OnCanvasTouchMove"
                                   TouchUp="OnCanvasTouchUp"
                                   StylusDown="OnCanvasStylusDown"
                                   StylusMove="OnCanvasStylusMove"
                                   StylusUp="OnCanvasStylusUp"
                                   Cursor="Cross"/>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- RIGHT PANEL: Palette & Brush Size -->
            <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="18" Padding="12" Margin="8,0,0,0" Style="{StaticResource KidCardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Selected Colour Preview -->
                        <TextBlock Text="COLOURS" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,6"/>

                        <Border Width="60" Height="60" CornerRadius="30"
                                BorderBrush="#E2E8F0" BorderThickness="4"
                                HorizontalAlignment="Center" Margin="0,0,0,8"
                                Background="{Binding SelectedColorBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="3" Opacity="0.2" Color="#000000"/>
                            </Border.Effect>
                        </Border>

                        <Button Style="{StaticResource KidRoundButtonStyle}" Content="🎨 Custom Colour..." Height="38"
                                Background="#8B5CF6" Foreground="#FFFFFF" Margin="0,0,0,12"
                                Command="{Binding PickCustomColorCommand}"/>

                        <!-- Predefined Palette Swatches -->
                        <ItemsControl ItemsSource="{Binding PaletteColors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="36" Height="36" Margin="3" Cursor="Hand"
                                            Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding Name}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="18" Background="{Binding Brush}" BorderBrush="#CBD5E1" BorderThickness="2"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Background="#E2E8F0" Margin="5,14,5,10"/>

                        <!-- Line / Brush Thickness -->
                        <TextBlock Text="LINE THICKNESS" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        
                        <!-- 4 Thickness Preset Buttons -->
                        <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,8">
                            <!-- Thin (4px) -->
                            <Button Width="50" Height="34" Margin="2" FontSize="11"
                                    Command="{Binding SelectThicknessCommand}" CommandParameter="4">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource KidRoundButtonStyle}">
                                        <Setter Property="Background" Value="#F1F5F9"/>
                                        <Setter Property="Foreground" Value="#334155"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsThinBrushSelected}" Value="True">
                                                <Setter Property="Background" Value="#10B981"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="Thin"/>
                            </Button>

                            <!-- Medium (8px) -->
                            <Button Width="50" Height="34" Margin="2" FontSize="11"
                                    Command="{Binding SelectThicknessCommand}" CommandParameter="8">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource KidRoundButtonStyle}">
                                        <Setter Property="Background" Value="#F1F5F9"/>
                                        <Setter Property="Foreground" Value="#334155"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMediumBrushSelected}" Value="True">
                                                <Setter Property="Background" Value="#10B981"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="Med"/>
                            </Button>

                            <!-- Thick (16px) -->
                            <Button Width="50" Height="34" Margin="2" FontSize="11"
                                    Command="{Binding SelectThicknessCommand}" CommandParameter="16">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource KidRoundButtonStyle}">
                                        <Setter Property="Background" Value="#F1F5F9"/>
                                        <Setter Property="Foreground" Value="#334155"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsThickBrushSelected}" Value="True">
                                                <Setter Property="Background" Value="#10B981"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="Thick"/>
                            </Button>

                            <!-- Jumbo (28px) -->
                            <Button Width="50" Height="34" Margin="2" FontSize="11"
                                    Command="{Binding SelectThicknessCommand}" CommandParameter="28">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource KidRoundButtonStyle}">
                                        <Setter Property="Background" Value="#F1F5F9"/>
                                        <Setter Property="Foreground" Value="#334155"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsJumboBrushSelected}" Value="True">
                                                <Setter Property="Background" Value="#10B981"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="Jumbo"/>
                            </Button>
                        </WrapPanel>

                        <!-- Live Interactive Brush Size Preview -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5"
                                CornerRadius="12" Padding="8,6" Margin="0,2,0,8" HorizontalAlignment="Center" Width="140">
                            <StackPanel HorizontalAlignment="Center">
                                <Grid Width="48" Height="48" HorizontalAlignment="Center">
                                    <Ellipse Stroke="#CBD5E1" StrokeThickness="1" StrokeDashArray="2 2" Width="46" Height="46"/>
                                    <Ellipse Width="{Binding BrushPreviewSize}" Height="{Binding BrushPreviewSize}"
                                             Fill="{Binding BrushPreviewColorBrush}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="{Binding BrushThicknessDescription}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Slider Minimum="2" Maximum="36" Value="{Binding BrushThickness}" Margin="8,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- BOTTOM ACTION BAR -->
        <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="16" Padding="14,10" Margin="0,8,0,0" Style="{StaticResource KidCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Back to Home -->
                <Button Style="{StaticResource KidRoundButtonStyle}"
                        Background="#64748B" Width="140" Height="46"
                        Command="{Binding BackCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⬅" FontSize="18" Margin="0,0,8,0"/>
                        <TextBlock Text="Home" FontSize="15"/>
                    </StackPanel>
                </Button>

                <!-- Center Save, PNG & Print -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource KidRoundButtonStyle}"
                            Background="#10B981" Width="160" Height="46" Margin="0,0,12,0"
                            Command="{Binding SaveDrawingCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Save to Gallery" FontSize="15"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource KidRoundButtonStyle}"
                            Background="#F59E0B" Width="160" Height="46" Margin="0,0,12,0"
                            Command="{Binding ExportPngCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖼" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Export PNG" FontSize="15"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource KidRoundButtonStyle}"
                            Background="#3B82F6" Width="160" Height="46"
                            Command="{Binding PrintDrawingCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Print Drawing" FontSize="15"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
