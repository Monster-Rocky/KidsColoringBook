<Window x:Class="KidsColoringBook.Views.TextInputDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enter Text"
        Height="240" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border BorderBrush="#42A5F5" BorderThickness="4" CornerRadius="20" Background="#FFFFFF" Padding="25">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock x:Name="TxtTitle" Text="✏ Enter Your Name"
                       FontSize="20" FontWeight="Bold" Foreground="#1565C0"
                       FontFamily="Comic Sans MS, Segoe UI" HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <!-- Input Box -->
            <TextBox x:Name="TxtInput" Grid.Row="1"
                     FontSize="18" FontWeight="SemiBold"
                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                     Height="44" Padding="8,4" Margin="10,0"
                     BorderBrush="#90CAF9" BorderThickness="2">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                <Button Content="✔ Save" Width="120" Height="42"
                        Background="#4CAF50" Foreground="White"
                        FontWeight="Bold" FontSize="15"
                        Margin="0,0,12,0" Click="OnOkClick">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="21"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="Cancel" Width="100" Height="42"
                        Background="#9E9E9E" Foreground="White"
                        FontWeight="Bold" FontSize="15"
                        Click="OnCancelClick">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="21"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
