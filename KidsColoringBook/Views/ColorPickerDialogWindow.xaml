<Window x:Class="KidsColoringBook.Views.ColorPickerDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Magic Color Picker"
        Height="480" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8F9FA"
        WindowStyle="None"
        AllowsTransparency="True">
    
    <Border BorderBrush="#4A90E2" BorderThickness="3" CornerRadius="16" Background="#FFFFFF">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Text="🎨 Pick Your Magic Colour!"
                       FontSize="22" FontWeight="Bold"
                       Foreground="#2C3E50"
                       HorizontalAlignment="Center" Margin="0,0,0,15"
                       FontFamily="Comic Sans MS, Segoe UI"/>

            <!-- Preview Swatch -->
            <Border Grid.Row="1" Width="100" Height="100" CornerRadius="50"
                    BorderBrush="#CCCCCC" BorderThickness="3"
                    HorizontalAlignment="Center" Margin="0,0,0,15"
                    ClipToBounds="True">
                <Rectangle x:Name="ColorPreview" Fill="#FF2196F3"/>
            </Border>

            <!-- Sliders -->
            <StackPanel Grid.Row="2" VerticalAlignment="Center">
                <!-- Red -->
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Red" FontWeight="Bold" Foreground="#E53935" VerticalAlignment="Center" FontSize="14"/>
                    <Slider x:Name="SliderR" Grid.Column="1" Minimum="0" Maximum="255" Value="33" ValueChanged="OnSliderValueChanged" Margin="5,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding ElementName=SliderR, Path=Value, StringFormat={}{0:0}}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- Green -->
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Green" FontWeight="Bold" Foreground="#43A047" VerticalAlignment="Center" FontSize="14"/>
                    <Slider x:Name="SliderG" Grid.Column="1" Minimum="0" Maximum="255" Value="150" ValueChanged="OnSliderValueChanged" Margin="5,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding ElementName=SliderG, Path=Value, StringFormat={}{0:0}}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- Blue -->
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Blue" FontWeight="Bold" Foreground="#1E88E5" VerticalAlignment="Center" FontSize="14"/>
                    <Slider x:Name="SliderB" Grid.Column="1" Minimum="0" Maximum="255" Value="243" ValueChanged="OnSliderValueChanged" Margin="5,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding ElementName=SliderB, Path=Value, StringFormat={}{0:0}}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- Preset Quick Swatches -->
                <TextBlock Text="Quick Choices:" FontWeight="SemiBold" Foreground="#666" Margin="0,15,0,8"/>
                <WrapPanel HorizontalAlignment="Center">
                    <Button Width="32" Height="32" Margin="3" Background="#FF1744" Click="OnPresetClick" Tag="#FFFF1744" BorderThickness="1" BorderBrush="#AAA"/>
                    <Button Width="32" Height="32" Margin="3" Background="#FF9100" Click="OnPresetClick" Tag="#FFFF9100" BorderThickness="1" BorderBrush="#AAA"/>
                    <Button Width="32" Height="32" Margin="3" Background="#FFEA00" Click="OnPresetClick" Tag="#FFFFEA00" BorderThickness="1" BorderBrush="#AAA"/>
                    <Button Width="32" Height="32" Margin="3" Background="#00E676" Click="OnPresetClick" Tag="#FF00E676" BorderThickness="1" BorderBrush="#AAA"/>
                    <Button Width="32" Height="32" Margin="3" Background="#00B0FF" Click="OnPresetClick" Tag="#FF00B0FF" BorderThickness="1" BorderBrush="#AAA"/>
                    <Button Width="32" Height="32" Margin="3" Background="#651FFF" Click="OnPresetClick" Tag="#FF651FFF" BorderThickness="1" BorderBrush="#AAA"/>
                    <Button Width="32" Height="32" Margin="3" Background="#F50057" Click="OnPresetClick" Tag="#FFF50057" BorderThickness="1" BorderBrush="#AAA"/>
                    <Button Width="32" Height="32" Margin="3" Background="#795548" Click="OnPresetClick" Tag="#FF795548" BorderThickness="1" BorderBrush="#AAA"/>
                </WrapPanel>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                <Button Content="✔ Use Color" Width="140" Height="42"
                        Background="#4CAF50" Foreground="White"
                        FontWeight="Bold" FontSize="15"
                        Margin="0,0,10,0" Click="OnSelectClick">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="21"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="Cancel" Width="100" Height="42"
                        Background="#9E9E9E" Foreground="White"
                        FontWeight="Bold" FontSize="15"
                        Click="OnCancelClick">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="21"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
