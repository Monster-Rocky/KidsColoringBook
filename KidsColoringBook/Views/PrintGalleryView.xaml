<UserControl x:Class="KidsColoringBook.Views.PrintGalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="{StaticResource AppBackgroundBrush}">

    <Grid Margin="25,15,25,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Tabs: Original Sketches vs Coloured -->
            <RowDefinition Height="Auto"/> <!-- Difficulty filters for original -->
            <RowDefinition Height="*"/>    <!-- Items Grid -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Style="{StaticResource KidRoundButtonStyle}"
                    Background="#9E9E9E" Width="140" Height="46"
                    Command="{Binding BackCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⬅" FontSize="18" Margin="0,0,8,0"/>
                    <TextBlock Text="Home" FontSize="16"/>
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="1" Text="🖨 Print Gallery"
                       FontSize="28" FontWeight="Bold" Foreground="#2C3E50"
                       FontFamily="{StaticResource KidFontFamily}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- Primary Mode Tabs: Original Sketches vs Coloured Artwork -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="22" Padding="6" Margin="0,0,0,12" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <Button Content="📄 Original B&amp;W Sketches (300)" Width="250" Height="44" Margin="4,0"
                        Command="{Binding SelectTabCommand}" CommandParameter="OriginalSketches">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource KidRoundButtonStyle}">
                            <Setter Property="Background" Value="#E2E8F0"/>
                            <Setter Property="Foreground" Value="#475569"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOriginalTab}" Value="True">
                                    <Setter Property="Background" Value="#3B82F6"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="🎨 My Coloured Artwork" Width="230" Height="44" Margin="4,0"
                        Command="{Binding SelectTabCommand}" CommandParameter="ColouredArtwork">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource KidRoundButtonStyle}">
                            <Setter Property="Background" Value="#E2E8F0"/>
                            <Setter Property="Foreground" Value="#475569"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsColouredTab}" Value="True">
                                    <Setter Property="Background" Value="#10B981"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- Difficulty Pills (only visible when Original tab is active) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOriginalTab}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <Button Style="{StaticResource KidRoundButtonStyle}" Content="Easy (100)" Width="120" Height="38" Margin="4,0"
                    Background="#F1F5F9" Foreground="#334155" Command="{Binding SelectDifficultyCommand}" CommandParameter="Easy"/>
            <Button Style="{StaticResource KidRoundButtonStyle}" Content="Medium (100)" Width="130" Height="38" Margin="4,0"
                    Background="#F1F5F9" Foreground="#334155" Command="{Binding SelectDifficultyCommand}" CommandParameter="Medium"/>
            <Button Style="{StaticResource KidRoundButtonStyle}" Content="Hard (100)" Width="120" Height="38" Margin="4,0"
                    Background="#F1F5F9" Foreground="#334155" Command="{Binding SelectDifficultyCommand}" CommandParameter="Hard"/>
        </StackPanel>

        <!-- Content List -->
        <Grid Grid.Row="3">
            <!-- Original Sketches List -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOriginalTab}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <ItemsControl ItemsSource="{Binding OriginalSketches}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="200" Height="250" Margin="10" Style="{StaticResource KidCardStyle}">
                                <Grid Margin="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="140"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Background="#F8FAFC" CornerRadius="12" ClipToBounds="True">
                                        <Image Source="{Binding ThumbnailPath}" Stretch="Uniform" Margin="4"/>
                                    </Border>

                                    <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="14" FontWeight="Bold"
                                               Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,6,0,6"
                                               TextTrimming="CharacterEllipsis"/>

                                    <Button Grid.Row="2" Style="{StaticResource KidRoundButtonStyle}"
                                            Content="🖨 Print B&amp;W" Height="36"
                                            Background="#2563EB" FontSize="13"
                                            Command="{Binding DataContext.PrintSketchOriginalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Coloured Drawings List -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsColouredTab}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <ItemsControl ItemsSource="{Binding ColouredDrawings}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="220" Height="270" Margin="10" Style="{StaticResource KidCardStyle}">
                                <Grid Margin="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="150"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Background="#F8FAFC" CornerRadius="12" ClipToBounds="True">
                                        <Image Source="{Binding ThumbnailPath}" Stretch="Uniform" Margin="4"/>
                                    </Border>

                                    <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="14" FontWeight="Bold"
                                               Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,6,0,6"
                                               TextTrimming="CharacterEllipsis"/>

                                    <Button Grid.Row="2" Style="{StaticResource KidRoundButtonStyle}"
                                            Content="🖨 Print Coloured" Height="36"
                                            Background="#10B981" FontSize="13"
                                            Command="{Binding DataContext.PrintUserArtworkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
