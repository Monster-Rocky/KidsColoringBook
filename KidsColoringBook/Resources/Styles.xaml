<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary Palette -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F7FC"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextDarkBrush" Color="#2C3E50"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#7F8C8D"/>
    
    <SolidColorBrush x:Key="AccentCoral" Color="#FF6B6B"/>
    <SolidColorBrush x:Key="AccentBlue" Color="#4D96FF"/>
    <SolidColorBrush x:Key="AccentGreen" Color="#6BCB77"/>
    <SolidColorBrush x:Key="AccentYellow" Color="#FFD93D"/>
    <SolidColorBrush x:Key="AccentPurple" Color="#9D4EDD"/>
    <SolidColorBrush x:Key="AccentOrange" Color="#FF923C"/>

    <!-- Common Child-Friendly Font Family -->
    <FontFamily x:Key="KidFontFamily">Comic Sans MS, Segoe UI, Arial Rounded MT Bold, sans-serif</FontFamily>

    <!-- Standard Rounded Card Style -->
    <Style x:Key="KidCardStyle" TargetType="Border">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="BorderBrush" Value="#E2E8F0"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="3" Opacity="0.08" Color="#000000"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Kid Action Button Style -->
    <Style x:Key="KidRoundButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource KidFontFamily}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            CornerRadius="24" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="3" Opacity="0.15" Color="#000000"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dashboard Big Tile Button Style -->
    <Style x:Key="DashboardTileStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource KidFontFamily}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="tileBorder" Background="{TemplateBinding Background}"
                            CornerRadius="28" BorderBrush="#FFFFFF" BorderThickness="4"
                            Padding="20" SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="6" Opacity="0.2" Color="#000000"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="tileBorder" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.04" ScaleY="1.04" CenterX="120" CenterY="100"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="tileBorder" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97" CenterX="120" CenterY="100"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
