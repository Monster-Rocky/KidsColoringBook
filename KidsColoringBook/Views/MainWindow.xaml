<Window x:Class="KidsColoringBook.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KidsColoringBook.ViewModels"
        xmlns:views="clr-namespace:KidsColoringBook.Views"
        Title="Kids Coloring Book"
        Height="800" Width="1200"
        MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GalleryViewModel}">
            <views:GalleryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ColoringViewModel}">
            <views:ColoringView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DrawOwnViewModel}">
            <views:DrawOwnView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MyDrawingsViewModel}">
            <views:MyDrawingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PrintGalleryViewModel}">
            <views:PrintGalleryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="WindowStyle" Value="SingleBorderWindow"/>
            <Setter Property="WindowState" Value="Normal"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFullScreen}" Value="True">
                    <Setter Property="WindowStyle" Value="None"/>
                    <Setter Property="WindowState" Value="Maximized"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <Grid>
        <ContentControl Content="{Binding CurrentView}"/>
    </Grid>
</Window>
